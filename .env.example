# Пример переменных окружения. Скопируйте в .env.local и поправьте под себя —
# .env* исключены из git, в репозиторий попадает только этот файл.
# Значения читаются на старте сервера (dotenv), все они необязательные.

# Секрет для подписи JWT. Если не задан, используется встроенное значение по
# умолчанию — оно годится только для локальной разработки. Перед реальным
# использованием задайте собственную длинную случайную строку.
JWT_SECRET="change-me-to-a-long-random-string"

# Порт локального Express-сервера (веб-режим).
PORT=3000

# Путь к файлу базы SQLite. По умолчанию — local-hr-docs.db в корне проекта.
# Тесты подставляют сюда временную базу, чтобы не трогать рабочие данные.
DB_PATH="local-hr-docs.db"
